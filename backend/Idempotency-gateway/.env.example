# Server
PORT=3000
HOST=0.0.0.0
APP_ENV=development

# Idempotency
# TTL for cached idempotency keys (seconds). Default: 24 hours.
IDEMPOTENCY_TTL_SECONDS=86400
# How often the background sweeper purges expired keys (seconds).
IDEMPOTENCY_SWEEP_INTERVAL_SECONDS=60

# Simulated payment processing delay (seconds)
PAYMENT_SIMULATED_DELAY_SECONDS=2.0

# Max JSON body bytes (used by FastAPI middleware; enforced at app level).
MAX_REQUEST_BODY_BYTES=102400

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
